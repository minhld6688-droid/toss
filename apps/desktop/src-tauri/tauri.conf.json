{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toss",
  "version": "0.8.0",
  "identifier": "com.minhfatz.toss",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Toss",
        "width": 400,
        "height": 600,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "category": "Utility",
    "shortDescription": "Chuyển file P2P cho studio ảnh",
    "longDescription": "Toss: kéo folder thả vào tên một máy là gửi, hoặc tạo link cho ai cũng nhận được. Máy nào cũng như nhau. Kết nối trực tiếp P2P, không qua máy chủ.",
    "copyright": "MinhFatz",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "bundle/entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installerHooks": "bundle/hooks.nsh",
        "installMode": "both",
        "languages": [
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "toss"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEMjU4RjZCOTk0OTA4MDAKUldRQUNFbVphNDhsUFQ2YndvUmZSallXUU15TzVxUS9EcSsvR2M0K0xnM0o5Uzd4YlpGb3puUDEK",
      "endpoints": [
        "https://github.com/minhld6688-droid/toss/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "Toss"
}
